# نمونه تنظیمات — مقادیر واقعی را در .env (خارج از مخزن) قرار دهید
BPMS_DATABASE_URL=sqlite:///./bpms.db
BPMS_JWT_SECRET=change-me-to-a-long-random-secret
BPMS_UPLOAD_DIR=./uploads
BPMS_MAX_UPLOAD_MB=20
BPMS_TIMEZONE=Asia/Tehran

# ---------- فاز ۳ ----------
# زمان‌بند: inprocess (پیش‌فرض توسعه/پایلوت) یا celery (عملیات با Worker پایدار)
BPMS_SCHEDULER_MODE=inprocess
# فاصله تیک موتور و بررسی SLA (ثانیه) — فقط در حالت inprocess
BPMS_TICK_SECONDS=30
BPMS_SLA_SECONDS=300
# آستانه هشدار SLA (درصد از کل زمان مجاز وظیفه)
BPMS_SLA_WARN_PCT=80
# Redis اختیاری برای پل SSE چندفرایندی (خالی = فقط درون‌فرایندی)
BPMS_REDIS_URL=
# Celery (در حالت celery)
BPMS_CELERY_BROKER_URL=redis://localhost:6379/1
BPMS_CELERY_RESULT_BACKEND=

# ---------- فاز ۵ — یکپارچه‌سازی ----------
# BPMS_OIDC_ENABLED=true
# BPMS_OIDC_ISSUER=https://sso.example.com/realms/bpms
# BPMS_OIDC_CLIENT_ID=bpms
# BPMS_OIDC_CLIENT_SECRET=
# BPMS_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
# BPMS_OIDC_DEFAULT_ROLE=operator
# BPMS_LDAP_ENABLED=false
# BPMS_LDAP_URL=ldap://dc.example.local:389
# BPMS_LDAP_BIND_DN=
# BPMS_LDAP_BIND_PASSWORD=
# BPMS_LDAP_USER_BASE=
# BPMS_LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
